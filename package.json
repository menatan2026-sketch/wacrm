{
  "name": "mfg-platform",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint . && pnpm run lint:deps",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @mfg/e2e e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "pnpm --filter @mfg/i18n check",
    "db:migrate": "pnpm --filter @mfg/db migrate",
    "db:seed": "pnpm --filter @mfg/core seed -- --dev",
    "db:reset": "pnpm --filter @mfg/db reset",
    "dev:services": "bash infrastructure/local/services.sh start",
    "dev:services:stop": "bash infrastructure/local/services.sh stop",
    "dev:geometry": "cd services/geometry && set -a && . ../../.env && set +a && uv run uvicorn geometry.app:app --host 127.0.0.1 --port 8001"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "dependency-cruiser": "^17.3.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
