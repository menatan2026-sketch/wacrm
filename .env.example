# Copy to .env and adjust. Every variable is validated at startup (packages/config).
# Never commit real secrets. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
APP_URL=http://localhost:3000
# HMAC/encryption root secret (≥ 32 chars). Rotating it invalidates sessions, upload links and MFA seeds.
APP_SECRET=replace-with-a-random-64-char-hex-string-0000000000000000000000

DATABASE_URL=postgres://mfg@127.0.0.1:5432/mfg
TEST_DATABASE_URL=postgres://mfg@127.0.0.1:5432/mfg_test
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info

# Storage: "local" (dev/CI, files under STORAGE_LOCAL_DIR) or "s3" (any S3-compatible private bucket).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local/storage
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=mfg-private
# S3_ACCESS_KEY_ID=mfg-local
# S3_SECRET_ACCESS_KEY=mfg-local-secret
# S3_FORCE_PATH_STYLE=true

# Email: "log" stores messages in the email_messages table (dev mailbox); "smtp" sends them.
EMAIL_DRIVER=log
# SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="Platform <no-reply@localhost>"

# Internal geometry service (services/geometry). Must match GEOMETRY_SHARED_SECRET there.
GEOMETRY_URL=http://127.0.0.1:8001
GEOMETRY_SHARED_SECRET=replace-with-a-random-secret-0000

# Payments: only the development "fake" provider exists until a certified PSP adapter lands (KNOWN_ISSUES KI-007).
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-secret-0000

# Shipping: "manual" (staff enters tracking) or "fake" (development courier).
SHIPPING_PROVIDER=fake

# Development helpers (dev mailbox page). Refused when NODE_ENV=production.
DEV_TOOLS_ENABLED=true
