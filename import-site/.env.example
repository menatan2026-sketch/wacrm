# ── Lead delivery ────────────────────────────────────────────────
# Leads from every form (vehicle requests, "find it for you",
# calculator hand-offs) are POSTed to /api/leads and fanned out to
# every sink that is configured below. With nothing configured,
# leads are logged server-side only (development).

# wacrm (this repository's CRM). Create an API key with the
# `contacts:write` scope under Settings → API keys.
WACRM_API_URL=
WACRM_API_KEY=

# Generic JSON webhook (Zapier, Make, n8n, your own endpoint).
LEAD_WEBHOOK_URL=

# ── Public contact details (rendered in the UI) ─────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=972500000000
NEXT_PUBLIC_CONTACT_EMAIL=import@portolan.example
NEXT_PUBLIC_CONTACT_PHONE=+972 3 000 0000
